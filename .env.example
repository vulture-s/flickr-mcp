# Flickr MCP credentials — copy to .env (gitignored) or set in your MCP config.
# Key/Secret come from your app: https://www.flickr.com/services/apps/create/
# The two OAuth tokens come from running: python authorize.py
FLICKR_API_KEY=
FLICKR_API_SECRET=
FLICKR_OAUTH_TOKEN=
FLICKR_OAUTH_TOKEN_SECRET=
